// Prisma schema — 多用户 AI 生成面板（三阶段流水线）
// P1 生成形象 -> P2 获取灵感 -> P3 视频生成
// 数据库：PostgreSQL 18
// 运行： npx prisma generate && npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户角色
enum Role {
  super_admin
  normal_user
}

// 网络访问范围（SSRF 防护）
enum NetworkScope {
  restricted
  broad
}

// 任务类型 —— 三阶段流程 + 即梦
enum TaskType {
  character // P1 生成形象（AI 渠道）
  inspiration // P2 获取灵感 -> 动作提示词（AI 渠道）
  video // P3 数字人视频（RunningHub，用户自备 Key）
  jimeng_image // 即梦图像生成（号池）
  jimeng_video // 即梦视频生成（号池）
}

// 任务状态
enum TaskStatus {
  pending
  running
  success
  failed
}

// 提示词类型：形象提示词（P1 用）/ 动作提示词（P2 产出、P3 用）
enum PromptType {
  character
  action
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  passwordHash String       @map("password_hash")
  role         Role         @default(normal_user)
  networkScope NetworkScope @default(restricted) @map("network_scope")
  status       Boolean      @default(true)
  createdBy    String?      @map("created_by")

  // P3 视频生成消耗 R 币，超出新用户 100R 免费额度，
  // 因此不做 Key 池随机选号，改为每个用户自填个人 RunningHub API Key（加密存储）。
  runninghubKeyEnc String?   @map("runninghub_key_enc")
  runninghubKeyAt  DateTime? @map("runninghub_key_at")

  // Hedra 提示词扩写用的个人 cookie（加密存储）。工作区调用 Hedra 时优先用此值，
  // 缺省回退到全局 .env 的 HEDRA_COOKIE_PATH。
  hedraCookieEnc String?   @map("hedra_cookie_enc")
  hedraCookieAt   DateTime? @map("hedra_cookie_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tasks   Task[]
  uploads Upload[]

  @@map("users")
}

// AI 渠道配置 —— 仅超级管理员可配置，全站共享（P1/P2 调用）
model AiChannel {
  id        String  @id @default(uuid())
  name      String // 渠道名称（如 "Edu 主力"）
  protocol  String  @default("openai") // openai | anthropic
  baseUrl   String  @map("base_url") // https://new.api.edu.gr/v1
  apiKeyEnc String  @map("api_key_enc") // AES-256-GCM 加密存储
  model     String? // 默认模型（如 Kimi K3 / GPT 5.6 Sol Max / Claude Opus 5）
  enabled   Boolean @default(true)

  // 该渠道可用于哪些阶段（逗号分隔：character,inspiration,song）
  usableFor String @default("character,inspiration,song") @map("usable_for")

  // 能力标记
  supportsImage  Boolean @default(true) @map("supports_image") // 支持生图
  supportsVision Boolean @default(true) @map("supports_vision") // 支持读图（P2 需要）
  streaming      Boolean @default(false)

  proxyUrl String? @map("proxy_url")
  remark   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled])
  @@map("ai_channels")
}

// 形象库（全站共享，P1 产出 / P2 P3 引用）
model Character {
  id          String   @id @default(uuid())
  name        String
  coverUrl    String?  @map("cover_url")
  category    String?
  tags        String[]
  description String?
  shared      Boolean  @default(true)
  // 入库状态：pending_review=AI 识别后待人工审核归档；active=已归档入库
  status      String   @default("active") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  images CharacterImage[]

  @@map("characters")
}

// 形象库下的多张生成图
model CharacterImage {
  id          String   @id @default(uuid())
  characterId String   @map("character_id")
  url         String
  localPath   String?  @map("local_path")
  prompt      String?
  model       String?
  // 风格/背景描述（同一形象下不同背景/风格的多张图，用于前端折叠分组）
  style       String?  @map("style")
  // 入库状态：active=已入库；pending_review=待审核（批量导入时）
  status      String   @default("active") @map("status")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@map("character_images")
}

// 素材索引（仅 URL + 文本工作信息，不再本地存原文件、不向前端共享展示）
// 由后端通过 /api/assets/sync 全量同步维护
model Asset {
  id          String   @id @default(uuid())
  kind        String // image | video | audio
  url         String   @unique
  title       String?
  description String?
  tags        String[]
  // 对应的工作信息（提示词、参数、来源任务等），自由结构
  workInfo    Json?    @map("work_info")
  source      String? // 来源标识（如 runninghub / character-gen / external）
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([kind])
  @@map("assets")
}

// 歌曲库（全站共享，P1 音乐信息 / P2 参考音频 / P3 对口型音频）
model Song {
  id          String   @id @default(uuid())
  title       String
  artist      String?
  url         String?
  localPath   String?  @map("local_path")
  duration    Int? // 秒
  category    String?
  tags        String[]
  lyrics      String? // 歌词/音乐信息，P1 P2 参考
  description String?
  language    String? // 语种（如 中文/英文/日语/纯音乐），AI 识别带出
  coverUrl    String?  @map("cover_url") // 封面图（下载源获取）
  // 入库状态：pending_review=AI 识别后待人工审核归档；active=已归档入库
  status      String   @default("active") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("songs")
}

// 提示词库（全站共享）
model Prompt {
  id          String     @id @default(uuid())
  title       String
  content     String
  type        PromptType @default(character)
  category    String?
  tags        String[]
  description String?
  createdBy   String?    @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("prompts")
}

// 任务（严格按 user_id 隔离）
model Task {
  id     String     @id @default(uuid())
  userId String     @map("user_id")
  type   TaskType
  status TaskStatus @default(pending)

  prompt           String? // P1 形象提示词 / P3 动作提示词
  params           Json?
  resultUrls       Json?   @map("result_urls")
  resultLocalPaths Json?   @map("result_local_paths")
  resultText       String? @map("result_text") // P2 产出的动作提示词
  resultData       Json?   @map("result_data") // 结构化结果（如获取灵感产出的 {characterPrompt, actionPrompt}）

  provider     String? // ai_channel | runninghub
  model        String?
  errorMessage String? @map("error_message")

  createdAt  DateTime  @default(now()) @map("created_at")
  finishedAt DateTime? @map("finished_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media    Media[]
  taskLogs TaskLog[]

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("tasks")
}

// 任务执行日志
model TaskLog {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  level     String // info | warn | error
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_logs")
}

// 用户上传的参考图 / 参考音频（按 user_id 隔离）
model Upload {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  kind      String // image | audio
  filename  String
  localPath String   @map("local_path")
  url       String // 可访问 URL（/api/files/xxx）
  size      Int
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("uploads")
}

// 生成结果落地登记
model Media {
  id        String   @id @default(uuid())
  taskId    String?  @map("task_id")
  type      String
  url       String
  localPath String?  @map("local_path")
  createdAt DateTime @default(now()) @map("created_at")

  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("media")
}

// 即梦（Jimeng）账号池 —— 管理员导入 cookie（概念 A：本地）/ 外部 :18813 拉取（概念 B）
model JimengAccount {
  id        String   @id @default(uuid())
  label     String? // 备注名
  cookieEnc String   @map("cookie_enc") // 加密存储的【完整 cookie map JSON】（整份保存，仅作兜底查值来源）
  sessionid String // 提取的核心 token（= sid_tt = sessionid_ss），用于 generateCookie 重建
  expireAt  DateTime? @map("expire_at") // 从 sessionid cookie 的 expirationDate 解析，用于过期提醒/重导
  status    String   @default("active") @map("status") // active | disabled | expired
  credits   Int      @default(0) // 最近一次查询的剩余积分
  source    String   @default("local") @map("source") // local（导入） | external（来自 :18813）
  lastUsedAt  DateTime? @map("last_used_at")
  lastCheckAt DateTime? @map("last_check_at")
  lastCheckinAt DateTime? @map("last_checkin_at") // 最近一次每日签到（领取积分）时间
  creditsUsed   Int      @default(0) @map("credits_used") // 累计已消耗积分（生成前后差值累加），用于选号权重
  checkinStreak Int      @default(0) @map("checkin_streak") // 连续签到天数

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("jimeng_accounts")
}

// 即梦异步任务（数字人轮询，本期暂缓）
model JimengTask {
  taskId     String   @id // 关联 tasks.id（统一任务体系）
  type       String
  status     String // processing | completed | failed
  progress   String?
  resultJson Json?   @map("result_json")
  userId     String?  @map("user_id")
  accountId  String?  @map("account_id") // 实际使用的号池账号
  creditsUsed Int?    @map("credits_used") // 本次任务消耗的即梦积分（生成前后差值）
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([accountId])
  @@map("jimeng_tasks")
}

// 三库共用标签字典
model Tag {
  id        String   @id @default(uuid())
  name      String
  type      String // character | song | prompt
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([name, type])
  @@map("tags")
}
