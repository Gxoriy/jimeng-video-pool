# ===== 数据库 =====
DATABASE_URL="postgres://postgres:abc123@127.0.0.1:5432/aigen_panel"

# ===== 服务监听（仅内网/回环，Nginx 前置）=====
HOST=127.0.0.1
PORT=8000

# ===== 鉴权 =====
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
SESSION_SECRET="change-me-session-secret"

# ===== Key 池（系统级，逗号拆分 = Bearer 拆分存储形态）=====
# 与 jimen2api 完全一致：多个 Key 用逗号分隔，运行时随机选号
OPENAI_API_KEYS="sk-xxx,sk-yyy"
RUNNINGHUB_API_KEYS="rh-xxx,rh-yyy"

# ===== 网络访问范围（EgressGuard，需求 #12 SSRF 防护）=====
# 普通用户仅允许访问这些公网主机（支持 *. 通配）；超级管理员可 broad
ALLOWED_EGRESS_HOSTS="api.openai.com,*.runninghub.cn"

# ===== 媒体存储（自动下载落地）=====
STORAGE_PATH="./data/media"
# 可选：对象存储（MinIO/S3），设置后优先上传
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ===== 可选 Redis（任务状态/会话缓存）=====
# REDIS_URL=redis://127.0.0.1:6379

# ===== RunningHub 数字人对口型工作流（需求 #9-#10）=====
RUNNINGHUB_API_BASE="https://www.runninghub.cn"
RUNNINGHUB_WORKFLOW_ID="2031016553440878594"
