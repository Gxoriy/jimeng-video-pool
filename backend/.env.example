# ===== 数据库 =====
DATABASE_URL="postgres://postgres:abc123@127.0.0.1:5432/jimen2api-all"

# ===== 服务监听（仅内网/回环，Nginx 前置）=====
HOST=0.0.0.0
PORT=18000

# ===== 鉴权 =====
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
SESSION_SECRET="change-me-session-secret"

# ===== API Key 说明 =====
# - AI 渠道（P1 生成形象 / P2 获取灵感）：由超级管理员在「AI 渠道配置」后台配置，无需在此填写。
# - RunningHub Key（P3 视频生成）：由每位用户在「个人设置」中自行填写（按用户隔离，无共享 Key 池）。
#   ⚠️ 以下 OPENAI_API_KEYS / RUNNINGHUB_API_KEYS 已废弃，请勿使用。
# OPENAI_API_KEYS="sk-xxx,sk-yyy"
# RUNNINGHUB_API_KEYS="rh-xxx,rh-yyy"

# ===== 网络访问范围（EgressGuard，需求 #12 SSRF 防护）=====
# 普通用户仅允许访问这些公网主机（支持 *. 通配）；超级管理员可 broad
ALLOWED_EGRESS_HOSTS="api.openai.com,*.runninghub.cn"

# ===== 媒体存储（自动下载落地）=====
STORAGE_PATH="./data/media"
# 可选：对象存储（MinIO/S3），设置后优先上传
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ===== 可选 Redis（任务状态/会话缓存）=====
# REDIS_URL=redis://127.0.0.1:6379

# ===== RunningHub 数字人对口型工作流（P3 视频生成）=====
RUNNINGHUB_API_BASE="https://www.runninghub.cn"
RUNNINGHUB_WORKFLOW_ID="2031016553440878594"
# 表单字段 -> ComfyUI 节点映射（JSON）。工作流 2031016553440878594 的节点编号已内置为默认值，
# 仅当你的工作流节点编号不同时才需要在此覆盖。格式：
# RUNNINGHUB_NODE_MAP={"image":{"nodeId":"444","fieldName":"image"},"audio":{"nodeId":"1755","fieldName":"audio"},"durationSeconds":{"nodeId":"1583","fieldName":"value"},"audioStartSeconds":{"nodeId":"1776","fieldName":"value"},"actionPrompt":{"nodeId":"1624","fieldName":"value"},"maxResolution":{"nodeId":"1606","fieldName":"value"},"fps":{"nodeId":"1586","fieldName":"value"}}
# 注意：该工作流只有「音频起始秒」节点，无「结束秒」节点。

# ===== 歌曲库批量导入 ·「歌名-作者」自动下载（参考 suno_auto_production-master）=====
# 音乐聚合 API 基址（默认 kuwo 第三方聚合接口）。该域名在 song-import 内以服务端受信(BROAD)方式访问，
# 仍受 EgressGuard 的 DNS 内网拦截保护，无需加入 ALLOWED_EGRESS_HOSTS。
MUSIC_SOURCE_BASE="https://kw-api.cenguigui.cn"
# ffprobe 路径（读取本地上传音频时长；留空则用 PATH 中的 ffprobe）。
# FFPROBE_PATH="ffprobe"

# ===== 参考图内联与降采样（规避上游网关 413 request body too large）=====
# ffmpeg 路径。留空则自动使用内置的 ffmpeg-static 二进制，无需系统安装 ffmpeg。
# FFMPEG_PATH=""
# 参考图内联 base64 的目标体积上限（KB，默认 180）。
# 若上游网关仍返回 413，调小为 100 / 60 即可。
# MAX_INLINE_IMAGE_KB="180"
