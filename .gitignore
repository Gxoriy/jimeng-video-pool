# 依赖
node_modules/
backend/node_modules/
frontend/node_modules/

# 构建产物
dist/
backend/dist/
frontend/dist/
# 本地测试时 frontend/dist 的副本（由 electron-builder extraResources 自动复制到打包产物，不入库）
backend/client/

# 环境变量 / 密钥
.env
*.local

# 运行时数据
data/
backend/data/
*.log

# 编辑器
.idea/
.vscode/
.DS_Store

# 本地凭证 / Cookie 导出（含 refresh_token 等，禁止入库）
ck.txt
*.cookie

# 构建临时产物（Vite 时间戳中间文件）
vite.config.ts.timestamp-*.mjs
frontend/vite.config.ts.timestamp-*.mjs

# 本地归档 / 临时验证脚本（非项目源码）
_deprecated/
backend/_verify_chat.js

# 打包输出（electron-builder 产物，体积大，禁止入库）
frontend/release/
frontend/release-build/
frontend/electron-dist/

# 即梦模块临时探查产物（含外部号池前端 bundle 副本，禁止入库）
.probe/

# TypeScript 增量构建缓存
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

